      <layer number="96" name="Values" color="1" fill="1" visible="yes" active="yes" />
    </layers>
    <board>
      <plain>
        <wire x1="0" y1="0" x2="80" y2="0" width="0" layer="20" />
        <wire x1="80" y1="0" x2="80" y2="60" width="0" layer="20" />
        <wire x1="80" y1="60" x2="0" y2="60" width="0" layer="20" />
        <wire x1="0" y1="60" x2="0" y2="0" width="0" layer="20" />
      </plain>
      <libraries>
        <library name="bridge-demo">
          <description>Original synthetic test geometry; not an electronic product.</description>
          <packages>
            <package name="DEMO_SMD">
              <smd name="1" x="-2.54" y="0" dx="1.5" dy="2" layer="1" />
              <smd name="2" x="2.54" y="0" dx="1.5" dy="2" layer="1" />
              <wire x1="-1" y1="-1" x2="1" y2="-1" width="0.15" layer="21" />
              <wire x1="1" y1="-1" x2="1" y2="1" width="0.15" layer="21" />
              <wire x1="1" y1="1" x2="-1" y2="1" width="0.15" layer="21" />
              <wire x1="-1" y1="1" x2="-1" y2="-1" width="0.15" layer="21" />
              <text x="-1" y="2" size="1" layer="25">&gt;NAME</text>
              <text x="-1" y="-3" size="1" layer="27">&gt;VALUE</text>
              <wire x1="-1" y1="3.5" x2="2" y2="4" width="0.4" layer="41" />
            </package>
            <package name="DEMO_THT">
              <pad name="1" x="-2.54" y="0" drill="0.8" diameter="1.8" shape="round" />
              <pad name="2" x="2.54" y="0" drill="0.8" diameter="1.8" shape="round" />
              <wire x1="-1" y1="-1" x2="1" y2="-1" width="0.15" layer="21" />
              <wire x1="1" y1="-1" x2="1" y2="1" width="0.15" layer="21" />
              <wire x1="1" y1="1" x2="-1" y2="1" width="0.15" layer="21" />
              <wire x1="-1" y1="1" x2="-1" y2="-1" width="0.15" layer="21" />
              <text x="-1" y="2" size="1" layer="25">&gt;NAME</text>
              <text x="-1" y="-3" size="1" layer="27">&gt;VALUE</text>
            </package>
          </packages>
          <symbols>
            <symbol name="PASSIVE">
              <wire x1="-2.54" y1="-1.27" x2="2.54" y2="-1.27" width="0.254" layer="94" />
              <wire x1="2.54" y1="-1.27" x2="2.54" y2="1.27" width="0.254" layer="94" />
              <wire x1="2.54" y1="1.27" x2="-2.54" y2="1.27" width="0.254" layer="94" />
              <wire x1="-2.54" y1="1.27" x2="-2.54" y2="-1.27" width="0.254" layer="94" />
              <pin name="A" x="-5.08" y="0" visible="off" length="short" direction="pas" />
              <pin name="B" x="5.08" y="0" visible="off" length="short" direction="pas" rot="R180" />
              <text x="-2.54" y="2.54" size="1.27" layer="95">&gt;NAME</text>
              <text x="-2.54" y="-3.81" size="1.27" layer="96">&gt;VALUE</text>
            </symbol>
          </symbols>
          <devicesets>
            <deviceset name="DEMO_SMD" prefix="R" uservalue="yes">
              <gates>
                <gate name="G$1" symbol="PASSIVE" x="0" y="0" />
              </gates>
              <devices>
                <device name="" package="DEMO_SMD">
                  <connects>
                    <connect gate="G$1" pin="A" pad="1" />
                    <connect gate="G$1" pin="B" pad="2" />
                  </connects>
                  <technologies>
                    <technology name="" />
                  </technologies>
                </device>
              </devices>
            </deviceset>
            <deviceset name="DEMO_THT" prefix="R" uservalue="yes">
              <gates>
                <gate name="G$1" symbol="PASSIVE" x="0" y="0" />
              </gates>
              <devices>
                <device name="" package="DEMO_THT">
                  <connects>
                    <connect gate="G$1" pin="A" pad="1" />
                    <connect gate="G$1" pin="B" pad="2" />
                  </connects>
                  <technologies>
                    <technology name="" />
                  </technologies>
                </device>
              </devices>
            </deviceset>
          </devicesets>
        </library>
      </libraries>
      <attributes />
      <variantdefs />
      <classes>
        <class number="0" name="default" width="0" drill="0" />
      </classes>
      <designrules name="Synthetic demo">
        <param name="layerSetup" value="(1*16)" />
        <param name="mdWireWire" value="0.2mm" />
        <param name="msWidth" value="0.2mm" />
        <param name="msDrill" value="0.3mm" />
        <param name="rlMinViaOuter" value="0.15mm" />
        <param name="rlMinPadTop" value="0.25mm" />
        <param name="rlMinPadBottom" value="0.25mm" />
      </designrules>
      <autorouter />
      <elements>
        <element name="R1" library="bridge-demo" package="DEMO_THT" value="test-01" x="-15" y="0" smashed="yes" rot="R0">
          <attribute name="NAME" x="-15.0" y="2.0" size="1" layer="25" />
          <attribute name="VALUE" x="-15.0" y="-3.0" size="1" layer="27" />
        </element>
        <element name="R2" library="bridge-demo" package="DEMO_SMD" value="test-02" x="-30" y="0" smashed="yes" rot="R0">
